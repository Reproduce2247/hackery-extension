    {
      "name": "Set list item limit",
      "type": "scriptlet",
      "code": "var glideListClassRef = globalThis.g_list ?? globalThis.gsft_main?.g_list ?? globalThis.GlideList2 ?? globalThis.gsft_main.GlideList2; if (!glideListClassRef.table) { var ids = Array.from(document.querySelectorAll('div.list_v2')).map(function(div) { return div.id.replace(/_list$/, ''); }); glideListClassRef = new GlideList2(ids[0]) } glideListClassRef.setRowsPerPage({limit});",
      "parameter": {
        "name": "limit",
        "placeholder": "limit",
        "default": "100"
      }
    },
    {
      "name": "Show navigator",
      "type": "scriptlet",
      "code": "(function(){var l=window.location,p=l.pathname.replace(/^\\/+/,'');if(/^now\\/nav\\/ui\\/classic\\/params\\/target\\//.test(p))return;var t=encodeURIComponent(p+l.search+l.hash);l.href=l.origin+'/now/nav/ui/classic/params/target/'+t;})();"
